#!/usr/bin/env bash
set -euo pipefail

# Install as `archive` command:
# 1) Symlink (recommended if path is stable):
#    ln -s "$(pwd)/archive" /usr/local/bin/archive
# 2) Shell alias (per-shell config):
#    alias archive='/path/to/scripts/archive'
# Add the alias to ~/.zshrc or ~/.bashrc, then reload your shell.

# Defaults/constants: destination directory, date stamp, optional label, and target list.
if [[ -d "${HOME}/Tomb" ]]; then
    DEST="${HOME}/Tomb"
elif [[ -d "${HOME}/tomb" ]]; then
    DEST="${HOME}/tomb"
else
    DEST="${HOME}/Tomb"
fi
DATE=$(date +%Y-%m-%d)
LABEL=""
TARGETS=()
LOG_FILE="${DEST}/.archive.log"
CLEAN_LOG=0
DELETE_ORIGINALS=0
LABEL_EXPLICIT=0
RESTORE_ARCHIVE=""
DEST_EXPLICIT=0

# Parse positional targets and supported flags.
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--destination)
            DEST="$2"
            DEST_EXPLICIT=1
            shift 2
            ;;
        --label)
            LABEL="$2"
            LABEL_EXPLICIT=1
            shift 2
            ;;
        --restore)
            RESTORE_ARCHIVE="$2"
            shift 2
            ;;
        --clean-log)
            CLEAN_LOG=1
            shift
            ;;
        -r|--remove)
            DELETE_ORIGINALS=1
            shift
            ;;
        --)
            shift
            TARGETS+=("$@")
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            TARGETS+=("$1")
            shift
            ;;
    esac
done

# Cleanup mode: remove log entries whose archive path no longer exists.
if [[ $CLEAN_LOG -eq 1 ]]; then
    REMOVED=0
    if [[ -f "$LOG_FILE" ]]; then
        TMP_LOG=$(mktemp)
        while IFS=$'\t' read -r SOURCE_PATH ARCHIVE_PATH REST; do
            if [[ -n "${ARCHIVE_PATH:-}" && -e "$ARCHIVE_PATH" ]]; then
                if [[ -n "${REST:-}" ]]; then
                    printf '%s\t%s\t%s\n' "$SOURCE_PATH" "$ARCHIVE_PATH" "$REST" >> "$TMP_LOG"
                else
                    printf '%s\t%s\n' "$SOURCE_PATH" "$ARCHIVE_PATH" >> "$TMP_LOG"
                fi
            else
                ((REMOVED+=1))
            fi
        done < "$LOG_FILE"
        mv "$TMP_LOG" "$LOG_FILE"
    fi
    echo "Removed $REMOVED entries"
    exit 0
fi

# Restore mode: extract an archived entry back to its source parent (or explicit destination).
if [[ -n "$RESTORE_ARCHIVE" ]]; then
    if [[ ${#TARGETS[@]} -gt 0 ]]; then
        echo "Error: --restore cannot be combined with archive targets." >&2
        exit 1
    fi

    if [[ ! -f "$LOG_FILE" ]]; then
        echo "Error: no log file found at $LOG_FILE" >&2
        exit 1
    fi

    MATCH_SOURCE=""
    MATCH_ARCHIVE=""
    if [[ "$RESTORE_ARCHIVE" == */* ]]; then
        while IFS=$'\t' read -r SOURCE_PATH ARCHIVE_PATH REST; do
            if [[ "$ARCHIVE_PATH" == "$RESTORE_ARCHIVE" ]]; then
                MATCH_SOURCE="$SOURCE_PATH"
                MATCH_ARCHIVE="$ARCHIVE_PATH"
                break
            fi
        done < "$LOG_FILE"
    else
        while IFS=$'\t' read -r SOURCE_PATH ARCHIVE_PATH REST; do
            if [[ "$(basename "$ARCHIVE_PATH")" == "$RESTORE_ARCHIVE" ]]; then
                MATCH_SOURCE="$SOURCE_PATH"
                MATCH_ARCHIVE="$ARCHIVE_PATH"
                break
            fi
        done < "$LOG_FILE"
    fi

    if [[ -z "$MATCH_ARCHIVE" || -z "$MATCH_SOURCE" ]]; then
        echo "Error: no log entry found for archive: $RESTORE_ARCHIVE" >&2
        exit 1
    fi
    if [[ ! -f "$MATCH_ARCHIVE" ]]; then
        echo "Error: archive file not found: $MATCH_ARCHIVE" >&2
        exit 1
    fi

    SOURCE_PARENT="$(dirname "$MATCH_SOURCE")"
    if [[ -d "$SOURCE_PARENT" ]]; then
        tar -xzf "$MATCH_ARCHIVE" -C "$SOURCE_PARENT"
        echo "Restored $MATCH_ARCHIVE to $SOURCE_PARENT"
        exit 0
    fi

    if [[ $DEST_EXPLICIT -eq 1 ]]; then
        mkdir -p "$DEST"
        tar -xzf "$MATCH_ARCHIVE" -C "$DEST"
        echo "Restored $MATCH_ARCHIVE to $DEST"
        exit 0
    fi

    echo "Warning: original destination does not exist: $SOURCE_PARENT" >&2
    echo "Re-run with --destination <dir> to specify where to extract." >&2
    exit 1
fi

# Validation: require at least one file/dir target.
if [[ ${#TARGETS[@]} -eq 0 ]]; then
    echo "Usage: archive [-d|--destination <dir>] [--label <name>] [--clean-log] [--restore <archive>] [-r] <file|dir>..." >&2
    exit 1
fi

# Derive a default label from the first target when none is supplied.
if [[ -z "$LABEL" ]]; then
    LABEL=$(basename "${TARGETS[0]}")
    LABEL="${LABEL:-archive}"
fi

if command -v realpath >/dev/null 2>&1; then
    SOURCE_PATH=$(realpath "${TARGETS[0]}")
else
    SOURCE_PATH="$(cd "$(dirname "${TARGETS[0]}")" && pwd)/$(basename "${TARGETS[0]}")"
fi

if [[ $LABEL_EXPLICIT -eq 0 ]]; then
    HASH=$(printf '%s' "$SOURCE_PATH" | shasum -a 256 | cut -c1-4)
fi

# Ensure destination and log file exist.
mkdir -p "$DEST"
touch "$LOG_FILE"

# Create a date-prefixed tarball and print its output path for callers.
# Format: YYYY-MM-DD_<hash>_<label>.tar.gz — hash after date groups by source dir.
ARCHIVE="${DEST}/${DATE}_${HASH:+${HASH}_}${LABEL}.tar.gz"
tar -czf "$ARCHIVE" -- "${TARGETS[@]}"
# Verify archive readability before deleting originals when --delete is requested.
if [[ $DELETE_ORIGINALS -eq 1 ]]; then
    if tar -tzf "$ARCHIVE" >/dev/null; then
        for target in "${TARGETS[@]}"; do
            rm -rf "$target"
        done
    else
        echo "Error: archive verification failed: $ARCHIVE" >&2
        rm -f "$ARCHIVE"
        exit 1
    fi
fi
# Log format: <source_path>\t<archive_path>\t<datetime>\t<size>\t<sha256>
DATETIME=$(date +%Y-%m-%dT%H:%M:%S)
SIZE=$(du -sh "$ARCHIVE" | cut -f1)
SHA256=$(shasum -a 256 "$ARCHIVE" | cut -d' ' -f1)
printf '%s\t%s\t%s\t%s\t%s\n' "$SOURCE_PATH" "$ARCHIVE" "$DATETIME" "$SIZE" "$SHA256" >> "$LOG_FILE"
echo "$ARCHIVE"
